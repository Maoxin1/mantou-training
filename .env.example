# Optional public login endpoint. Omit for local-only mode.
# Exposed in the browser; NEVER place a database URL, token or password here.
AUTH_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
# Server only. Set in your own Vercel project, never in frontend code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
