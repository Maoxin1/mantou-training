{
  "name": "mantou-training",
  "version": "2.3.5",
  "private": true,
  "type": "module",
  "description": "Personal local-first training cards with rules-based progression and Obsidian exports",
  "scripts": {
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node tests/browser-meals.mjs",
    "smoke:online": "node scripts/online-smoke.mjs",
    "test:update": "node scripts/online-update.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maoxin1/mantou-training.git"
  },
  "bugs": {
    "url": "https://github.com/Maoxin1/mantou-training/issues"
  },
  "homepage": "https://github.com/Maoxin1/mantou-training#readme",
  "keywords": [
    "pwa",
    "offline-first",
    "workout",
    "obsidian",
    "training"
  ],
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.64.1"
  },
  "overrides": {
    "zod": "4.6.6",
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/kysely-adapter": "1.7.7",
    "@better-auth/memory-adapter": "1.7.7",
    "@better-auth/mongo-adapter": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/prisma-adapter": "1.7.7",
    "@better-auth/telemetry": "1.7.7",
    "better-auth": "1.7.7"
  }
}
